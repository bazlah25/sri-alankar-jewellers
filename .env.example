# Supabase project URL and server-only secret key. Never use NEXT_PUBLIC_ for the secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Gmail account used to send customer order confirmations. Use a Google App Password, not your account password.
SMTP_USER=jewellerssrialankar@gmail.com
SMTP_APP_PASSWORD=your_google_app_password
ORDER_NOTIFICATION_EMAIL=jewellerssrialankar@gmail.com

# Public site URL used in customer email tracking links.
NEXT_PUBLIC_SITE_URL=https://sri-alankar-jewellers.vercel.app

# Optional dedicated HMAC secret for signed customer account sessions. If omitted, SAJ_ADMIN_SESSION_SECRET is used.
CUSTOMER_SESSION_SECRET=replace_with_a_long_random_secret
